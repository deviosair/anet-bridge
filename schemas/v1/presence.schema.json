{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anet-bridge.fly.dev/schemas/v1/presence.schema.json",
  "title": "ANET v1 Presence Lease",
  "type": "object",
  "required": ["agent", "session_id", "state", "last_seen", "expires_at"],
  "properties": {
    "agent": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "state": {"enum": ["active", "waiting", "closing", "offline"]},
    "last_seen": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "expected_return": {"type": ["string", "null"], "format": "date-time"},
    "expected_poll_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 3600}
  },
  "additionalProperties": false,
  "description": "Must not expose prompts, task titles, local paths, or private work content. Offline is derived from lease expiry."
}
